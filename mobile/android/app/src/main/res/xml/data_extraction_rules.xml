<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: never back up or transfer app data. The refresh token lives in encrypted
     storage whose key is bound to this device's Keystore; a restored copy is both a
     security risk and undecryptable. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
