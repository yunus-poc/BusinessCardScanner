# BusinessCard.Api production settings for deploy/docker-compose.yml.
# Copy to deploy/.env (git-ignored). Prefer a secret store (Key Vault, Docker/K8s secrets) for the
# values marked SECRET; this file is the simplest option for a single VM with restricted access.

ASPNETCORE_ENVIRONMENT=Production

# --- Entra ID (identifiers, not secrets) ---
AzureAd__TenantId=<directory-tenant-id>
AzureAd__ClientId=<api-app-client-id>

# --- On-Behalf-Of credential for Microsoft Graph ---
# Production: certificate in Key Vault (the host's managed identity needs read access).
AzureAd__ClientCredentials__0__SourceType=KeyVault
AzureAd__ClientCredentials__0__KeyVaultUrl=https://<vault-name>.vault.azure.net
AzureAd__ClientCredentials__0__KeyVaultCertificateName=<certificate-name>
# Alternative (less preferred), SECRET:
# AzureAd__ClientCredentials__0__SourceType=ClientSecret
# AzureAd__ClientCredentials__0__ClientSecret=<secret>

# --- Self-hosted LLM ---
# SECRET: same value as inference/secrets/llm_api_key.txt
Ai__ApiKey=<llm-api-key>
Ai__TimeoutMilliseconds=2500

# --- Reverse proxy in front of the API (CIDR of the proxy/ingress subnet) ---
ForwardedHeaders__KnownNetworks__0=10.0.0.0/24

# --- Operations ---
RateLimiting__PermitsPerMinute=60
# Telemetry__OtlpEndpoint=http://otel-collector:4317
Parsing__ReviewThreshold=0.80

# --- Compose ---
# API_BIND=127.0.0.1   # host interface for the API port; the reverse proxy connects here
# API_PORT=5080
