# Copy to .env (git-ignored) and adjust. No secrets here: the API key lives in secrets/llm_api_key.txt.

# Pin to a tested build tag or digest in production.
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server
LLAMA_IMAGE_CUDA=ghcr.io/ggml-org/llama.cpp:server-cuda

LLM_MODEL_FILE=microsoft_Phi-4-mini-instruct-Q4_K_M.gguf
LLM_MODEL_ALIAS=phi-4-mini-instruct

# Physical cores of the host (not hyper-threads) usually give the best CPU throughput.
LLM_THREADS=8
LLM_PARALLEL=4
LLM_CTX_SIZE=6144
LLM_MEMORY_LIMIT=6g
LLM_PORT=8080
